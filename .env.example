# PostgreSQL. Create the database before running Prisma migrations.
DATABASE_URL="postgresql://elite_one:change-me@localhost:5432/elite_one?schema=public"

# Generate a unique 32+ character value, for example: openssl rand -base64 48
JWT_SECRET="replace-with-a-long-random-secret"
PORT=3000
NODE_ENV=development

# Used by `npm run prisma:seed`; never commit real credentials.
SEED_ADMIN_EMAIL="admin@eliteone.local"
SEED_ADMIN_PASSWORD="ChangeMe-OnlyForLocalDevelopment"
